# Template for .env — copy to .env and fill in. .env is gitignored; never commit it.

# --- Kaggle ---
# kaggle.com -> Settings -> API -> Generate New Token
KAGGLE_API_TOKEN=

# --- AWS ---
# IAM console -> Users -> <your user> -> Security credentials -> Create access key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- Project ---
# From `terraform output bucket_name` (in infra/)
DATA_BUCKET=
